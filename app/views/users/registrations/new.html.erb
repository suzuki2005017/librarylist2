<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <span class="auth-sub-title">A COLLECTION OF LIBRARIES</span>
      <h1 class="auth-title">新規登録</h1>
      <div class="auth-divider">❖</div>
    </div>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="form-group">
        <%= f.label :email, "メールアドレス", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "example@email.com", class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "パスワード", class: "form-label" %>
        <% if @minimum_password_length %>
          <span class="field-hint">（<%= @minimum_password_length %>文字以上）</span>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "••••••••", class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, "パスワード（確認用）", class: "form-label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "form-input" %>
      </div>

      <div class="form-actions">
        <%= f.submit "アカウントを作成する", class: "btn-auth-primary" %>
      </div>
    <% end %>

    <div class="auth-footer">
      <p class="auth-switch-text">すでにアカウントをお持ちの方</p>
      <%= link_to "ログインはこちら", new_session_path(resource_name), class: "auth-link" %>
      <div class="back-home-box">
        <%= link_to "← 図書館リストに戻る", root_path, class: "back-home-link" %>
      </div>
    </div>
  </div>
</div>
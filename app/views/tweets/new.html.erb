<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <span class="auth-sub-title">A COLLECTION OF LIBRARIES</span>
      <h1 class="auth-title">ログイン</h1>
      <div class="auth-divider">❖</div>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |f| %>
      <div class="form-group">
        <%= f.label :email, "メールアドレス", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "example@email.com", class: "form-input" %>
      </div>

      <div class="form-group">
        <%= f.label :password, "パスワード", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", class: "form-input" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-group checkbox-group">
          <%= f.check_box :remember_me, class: "form-checkbox" %>
          <%= f.label :remember_me, "ログイン状態を保持する", class: "checkbox-label" %>
        </div>
      <% end %>

      <div class="form-actions">
        <%= f.submit "ログインする", class: "btn-auth-primary" %>
      </div>
    <% end %>

    <div class="auth-footer">
      <p class="auth-switch-text">アカウントをお持ちでない方</p>
      <%= link_to "新規登録（アカウント作成）はこちら", new_registration_path(resource_name), class: "auth-link" %>
      <div class="back-home-box">
        <%= link_to "← 図書館リストに戻る", root_path, class: "back-home-link" %>
      </div>
    </div>
  </div>
</div>
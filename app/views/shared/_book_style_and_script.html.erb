  }
  .side-nav-btn:hover {
    background: #ffffff !important;
    color: #120d09 !important;
    transform: translateY(-2px);
  }
  .side-nav-btn:active {
    transform: translateY(0);
  }

  /* 中央ページ表示バー */
  .page-indicator-bar {
    text-align: center;
    color: #d4af37;
    font-weight: bold;
    font-size: 1rem;
    margin-bottom: 15px;
    letter-spacing: 0.05em;
  }

  /* 3D 本構造 */
  .book-viewport {
    width: 860px;
    height: 540px;
    perspective: 2000px;
    position: relative;
    z-index: 10;
    flex-shrink: 0;
  }
  .book-spine {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 24px;
    transform: translateX(-50%);
    background: linear-gradient(to right, #0a0806 0%, #2b221d 50%, #0a0806 100%);
    z-index: 200;
    box-shadow: inset 0 0 8px rgba(0,0,0,0.9);
  }
  .book-body {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
  }
  .sheet {
    position: absolute;
    width: 430px;
    height: 100%;
    right: 0;
    top: 0;
    transform-origin: left center;
    transform-style: preserve-3d;
    transition: transform 0.8s cubic-bezier(0.645, 0.045, 0.355, 1);
    cursor: pointer;
  }
  .sheet.flipped {
    transform: rotateY(-180deg);
  }

  /* 面の共通スタイル */
  .face {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    box-sizing: border-box;
    padding: 30px;
    overflow: hidden;
  }
  .face.front { z-index: 2; }
  .face.back { transform: rotateY(180deg); z-index: 1; }

  /* 本文（羊皮紙風） */
  .inner-page {
    background-color: #ebdcb9;
    color: #2b1f17;
    border: 1px solid #c4b08d;

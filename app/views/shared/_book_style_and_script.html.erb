  }
  .btn-new { background: #d4af37 !important; color: #120d09 !important; border: 1px solid #d4af37 !important; }
  .btn-new:hover { background: #b89b5e !important; }
  .btn-login { background: transparent !important; color: #d4af37 !important; border: 1px solid #b89b5e !important; }
  .btn-login:hover { background: #b89b5e !important; color: #120d09 !important; }
  .btn-register { background: #5c4a38 !important; color: #fff !important; border: 1px solid #8c7355 !important; }
  .btn-logout { background: transparent !important; color: #a39281 !important; border: 1px solid #5c4a38 !important; }

  /* 本とボタンを包むメインエリア */
  .book-container-outer {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 20px !important;
    position: relative !important;
    margin: 10px auto 40px auto !important;
    width: 100% !important;
    max-width: 1100px !important;
  }

  /* 左右ナビゲーションボタン */
  .side-nav-btn {
    background: linear-gradient(135deg, #d4af37 0%, #b89b5e 100%) !important;
    color: #120d09 !important;
    border: 1px solid #d4af37 !important;
    padding: 12px 20px !important;
    font-size: 0.95rem !important;
    font-weight: bold !important;
    border-radius: 30px !important;
